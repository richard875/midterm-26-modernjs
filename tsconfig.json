{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "types": ["@modern-js/app-tools/types", "node"],
    "declaration": false,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@shared/*": ["./shared/*"], "@api/*": ["./api/lambda/*"] }
  },
  "include": [
    "src",
    "shared",
    "server",
    "api",
    "functions",
    "tests",
    "modern.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
