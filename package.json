{
  "name": "midterm-26-modernjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.3.0"
  },
  "scripts": {
    "dev": "modern dev",
    "build": "modern build",
    "serve": "modern serve",
    "build:pages": "npm run build && node scripts/package-pages.mjs",
    "preview:pages": "wrangler pages dev dist/pages --port 8788",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "postinstall": "node scripts/patch-modern-paths.mjs",
    "prepare:map": "node scripts/prepare-map.mjs"
  },
  "dependencies": {
    "@modern-js/runtime": "3.10.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@modern-js/app-tools": "3.10.3",
    "@modern-js/plugin-bff": "3.10.3",
    "@modern-js/tsconfig": "3.10.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "~5.9.3",
    "us-atlas": "3.0.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "@swc/core@1.16.18": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "@parcel/watcher@2.6.0": true,
    "core-js@3.51.0": true
  },
  "overrides": {
    "undici": "^7.30.1",
    "postcss-selector-parser": "^7.1.7"
  }
}
